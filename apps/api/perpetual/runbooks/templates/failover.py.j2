#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["boto3>=1.35"]
# ///
"""Perpetual generated failover script for stack `{{ stack_name }}` (spec §63.2, P1c-04).

Primary Region: {{ primary_region }} -> DR Region: {{ target_region }}
Generated by Perpetual; never executed by Perpetual. Run from an operator laptop:
    uv run failover.py --dry-run
    uv run failover.py
"""

from __future__ import annotations

import argparse
import json
import sys
import urllib.request
from pathlib import Path
from typing import Any

import boto3

DR_REGION = "{{ target_region }}"
RDS_REPLICA_ID = "{{ rds_replica_id }}"
ECS_CLUSTER = "{{ ecs_cluster }}"
ECS_SERVICE = "{{ ecs_service }}"
ECS_TARGET_DESIRED_COUNT = {{ ecs_target_desired_count }}
DR_HEALTH_CHECK_URL = "{{ dr_health_check_url }}"


def step_1_promote_rds(rds_client: Any, *, dry_run: bool) -> str:
    """Step 1: Verify RDS replica state and promote to standalone primary if needed."""
    response = rds_client.describe_db_instances(DBInstanceIdentifier=RDS_REPLICA_ID)
    instances = response.get("DBInstances", [])
    if not instances:
        raise RuntimeError(f"DR RDS instance {RDS_REPLICA_ID!r} not found in {DR_REGION}")

    instance = instances[0]
    source_id = instance.get("ReadReplicaSourceDBInstanceIdentifier")
    if not source_id:
        print(f"[step 1] SKIP: {RDS_REPLICA_ID} is already promoted (standalone primary)")
        return "already_promoted"

    if dry_run:
        print(f"[step 1] DRY-RUN: would promote RDS read replica {RDS_REPLICA_ID} in {DR_REGION}")
        return "dry_run"

    rds_client.promote_read_replica(DBInstanceIdentifier=RDS_REPLICA_ID)
    print(f"[step 1] OK: promoted RDS read replica {RDS_REPLICA_ID} in {DR_REGION}")
    return "promoted"


def step_2_scale_ecs(ecs_client: Any, *, dry_run: bool) -> str:
    """Step 2: Verify DR ECS desired count and scale up if below target."""
    response = ecs_client.describe_services(cluster=ECS_CLUSTER, services=[ECS_SERVICE])
    services = response.get("services", [])
    if not services:
        raise RuntimeError(f"DR ECS service {ECS_SERVICE!r} not found in cluster {ECS_CLUSTER!r}")

    current = int(services[0].get("desiredCount", 0))
    if current >= ECS_TARGET_DESIRED_COUNT:
        print(
            f"[step 2] SKIP: ECS service {ECS_SERVICE} already at desiredCount={current} "
            f"(>= {ECS_TARGET_DESIRED_COUNT})"
        )
        return "already_scaled"

    if dry_run:
        print(
            f"[step 2] DRY-RUN: would scale ECS service {ECS_SERVICE} "
            f"from {current} to {ECS_TARGET_DESIRED_COUNT}"
        )
        return "dry_run"

    ecs_client.update_service(
        cluster=ECS_CLUSTER,
        service=ECS_SERVICE,
        desiredCount=ECS_TARGET_DESIRED_COUNT,
    )
    print(f"[step 2] OK: scaled ECS service {ECS_SERVICE} to {ECS_TARGET_DESIRED_COUNT}")
    return "scaled"


def step_3_check_health(*, dry_run: bool, skip_http: bool = False) -> str:
    """Step 3: Check DR endpoint health before shifting traffic."""
    if dry_run or skip_http:
        print(f"[step 3] DRY-RUN: would GET {DR_HEALTH_CHECK_URL}")
        return "dry_run"

    with urllib.request.urlopen(DR_HEALTH_CHECK_URL, timeout=10) as resp:  # noqa: S310
        status = int(resp.status)
    if status != 200:
        raise RuntimeError(f"DR health check {DR_HEALTH_CHECK_URL} returned HTTP {status}")
    print(f"[step 3] OK: DR health check {DR_HEALTH_CHECK_URL} returned HTTP 200")
    return "healthy"


def run_failover(
    *,
    dry_run: bool = False,
    skip_http: bool = False,
    state_file: Path | None = None,
    rds_client: Any = None,
    ecs_client: Any = None,
) -> dict[str, str]:
    """Execute all failover steps in order (verify before acting, resumable)."""
    completed: set[str] = set()
    if state_file is not None and state_file.exists():
        completed = set(json.loads(state_file.read_text(encoding="utf-8")).get("completed", []))

    rds = rds_client or boto3.client("rds", region_name=DR_REGION)
    ecs = ecs_client or boto3.client("ecs", region_name=DR_REGION)

    if "promote_rds" in completed:
        rds_status = "already_promoted"
    else:
        rds_status = step_1_promote_rds(rds, dry_run=dry_run)
        if not dry_run and rds_status in {"promoted", "already_promoted"}:
            completed.add("promote_rds")

    if "scale_ecs" in completed:
        ecs_status = "already_scaled"
    else:
        ecs_status = step_2_scale_ecs(ecs, dry_run=dry_run)
        if not dry_run and ecs_status in {"scaled", "already_scaled"}:
            completed.add("scale_ecs")

    health_status = step_3_check_health(dry_run=dry_run, skip_http=skip_http)

    if state_file is not None and not dry_run:
        state_file.write_text(
            json.dumps({"completed": sorted(completed)}, indent=2) + "\n",
            encoding="utf-8",
        )

    return {
        "promote_rds": rds_status,
        "scale_ecs": ecs_status,
        "health_check": health_status,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Failover script for {{ stack_name }}.")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Verify AWS state without mutating any resources.",
    )
    parser.add_argument(
        "--skip-http",
        action="store_true",
        help="Skip the live HTTP health-check call (for offline emulator tests).",
    )
    args = parser.parse_args(argv)
    run_failover(dry_run=args.dry_run, skip_http=args.skip_http)
    return 0


if __name__ == "__main__":
    sys.exit(main())

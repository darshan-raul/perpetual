---
const pathname = Astro.url.pathname;
const isActive = (prefix: string) =>
  prefix === '/' ? pathname === '/' : pathname.startsWith(prefix);
---

<nav class="nav">
  <div class="nav-inner">
    <div class="nav-left">
      <a href="/" class="brand-lockup" aria-label="Perpetual home">
        <img src="/assets/logo.png" alt="" width="32" height="32" class="brand-logo-mark" />
        <span class="brand-name">perpetual</span>
        <span class="brand-tag">aws dr</span>
      </a>
    </div>

    <!-- Main Navigation Links -->
    <div class="nav-mid">
      <a class={`nav-link ${isActive('/docs') ? 'active' : ''}`} href="/docs">Docs</a>
      <a class={`nav-link ${isActive('/architecture') ? 'active' : ''}`} href="/architecture">Architecture</a>
      <a class={`nav-link ${isActive('/scope') ? 'active' : ''}`} href="/scope">Scope &amp; Rules</a>
      <a class={`nav-link ${isActive('/roadmap') ? 'active' : ''}`} href="/roadmap">Roadmap</a>
    </div>

    <div class="nav-right">
      <button class="nav-search-btn" data-open-search aria-label="Search site (Ctrl+K)" type="button">
        <svg class="search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="search-text">Search</span>
        <kbd class="search-kbd">
          <span class="mod-mac">&#8984;K</span>
          <span class="mod-win">Ctrl+K</span>
        </kbd>
      </button>

      <a href="/roadmap" class="nav-ver" title="View milestone roadmap">pre-alpha · M0</a>

      <button id="theme-toggle" class="icon-btn" aria-label="Toggle colour theme" title="Toggle light / dark theme" type="button">
        <svg class="sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <a class="nav-gh" href="https://github.com/darshan-raul/perpetual" target="_blank" rel="noopener noreferrer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
  <div class="nav-progress" id="nav-progress" aria-hidden="true"></div>
</nav>

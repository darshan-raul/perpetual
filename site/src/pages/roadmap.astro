---
import BaseLayout from '../layouts/BaseLayout.astro';

const milestones = [
  {
    id: 'M0 PoC',
    badge: 'IN PROGRESS',
    badgeClass: 'mark--write',
    title: 'M0 Proof of Concept — Core Engine & Fixture Loop',
    delivers:
      'Finish P0-11 -> P1 -> P1c on canonical test fixtures (ecs-broken, ecs-remediated), with lightweight P0-15 (canonical hashes, immutable evaluation/snapshot manifests, versioned fixture inputs; schema-migration upgrade registry deferred to v0.2), plus a first generated Terraform fix and laptop recovery script.',
    highlights: [
      'Repo layout, mise toolchain, ruff/mypy/pytest/import-linter CI gates (task-level progress in TRACKER.md)',
      'P0-11 NetworkX dependency graph with ALL / ANY / quorum groups, cycle termination, and lightweight P0-15 hashes/manifests',
      'P1 two-pass simulator (Impact Pass + DR Overlay Recovery Pass), FailureReasonChain, and catalog-backed RTO',
      'P1c PoC compile loop: generated companion Terraform (fmt + validate) and Python recovery script (moto dry run) re-simulated to ecs-remediated',
    ],
  },
  {
    id: 'M1 Alpha',
    badge: 'CLI-FIRST AWS SLICE',
    badgeClass: 'mark--read',
    title: 'M1 Alpha — CLI-First Real-AWS Vertical Slice (ECS + RDS)',
    delivers:
      'CLI-only P2 + P4 ECS + RDS vertical slice (perpetual scan -> simulate -> plan) validated against a real sandbox AWS account before building FastAPI and the React UI, using CloudTrail-only P2b observation (no VPC Flow Logs or UI yet).',
    highlights: [
      'Normalizers & cross-source identity resolution (P1b-02/03) feeding read-only boto3 collectors for ECS, RDS/Aurora, S3, ECR, Secrets/SSM, KMS, IAM, ALB/NLB, Route 53, ACM, CloudWatch Logs, and VPC',
      'CloudTrail-only P2b observation (S3 + LookupEvents) with contradiction and unobserved edge reporting (VPC Flow Logs deferred to v0.2)',
      'ECS + RDS + cross-cutting DR rule packs (§28–§32, §41), stack grouping, live simulation, recovery DAG RTO, and RPO in the CLI',
      '3-tier verification skeleton: botocore.stub.Stubber / moto unit tests, aws/aws-emulator integration, and opt-in real-AWS contract suite',
    ],
  },
  {
    id: 'v0.1 (M2 MVP)',
    badge: 'DETERMINISTIC MVP',
    badgeClass: 'mark--read',
    title: 'v0.1 — ECS + RDS End-to-End, Read-Only UI, Preset Optimizer & Runbooks (No LLM)',
    delivers:
      'End-to-end deterministic v0.1 release for ECS + RDS stacks (ECS, RDS/Aurora, S3, ECR, Secrets/SSM, KMS, IAM, ALB/NLB, Route 53, ACM, CloudWatch Logs, VPC): Terraform saved-plan import, read-only React Flow viewer + review/confirm/reject panel (structural edits in YAML overrides), preset-based Optimizer, companion Terraform + suggested edits, runbooks, and laptop-run Python recovery scripts.',
    highlights: [
      'Read-only React Flow graph viewer + evidence/review/confirm/reject panel (structural graph edits stay in P0-10 YAML overrides)',
      'Preset-based Optimizer: StaticCostProvider + 3–4 discrete stack presets (Backup/Restore, Pilot Light, Warm Standby) evaluated through the simulator (§54–§60)',
      'Companion Terraform for new DR resources + suggested edits by Terraform address, verified via supplied saved-plan JSON (§15.4, §61.1)',
      'Explanatory failover/failback runbooks, prerequisite scripts, and laptop-run Python recovery scripts from one DAG (§63)',
      'Immutable EvaluationInput SHA-256 digests binding scans, overrides, and DRSpec approvals (§56.3); 100% deterministic (no EKS, P2c, Flow Logs, or ARC compiler)',
    ],
  },
  {
    id: 'v0.2 (M3 Expansion)',
    badge: 'DETERMINISTIC EXPANSION',
    badgeClass: 'mark--read',
    title: 'v0.2 — EKS, Expanded Services, Flow Logs, ARC Compiler & Full Optimizer',
    delivers:
      'Full multi-service deterministic expansion adding the Amazon EKS readiness pack (P7), P2c services (EC2/ASG, Lambda, SQS/SNS, CloudFront, WAF, EBS/EFS, DynamoDB), VPC Flow Logs + time-aware ENI resolution + ambiguous candidate-set review UI (P2b-04/09), interactive structural UI graph editor (P1b-10), full combinatorial Optimizer + AWSPricingProvider, ARC Region switch plan compiler (P11-07), and schema-migration upgrade registry (P0-15b).',
    highlights: [
      'EKS readiness pack (§33–§40): control plane, node groups/Karpenter, EBS/EFS CSI add-ons, IRSA/Pod Identity, PVCs, and §89 EKS demo',
      'Expanded P2c collectors, rule packs, RPO estimators, and companion templates (EC2/ASG, Lambda, SQS/SNS, CloudFront, WAF, EBS/EFS, DynamoDB)',
      'VPC Flow Logs + time-aware ENI resolution, ambiguous candidate-set review UI (§14.1), and interactive structural graph editor (P1b-10)',
      'Full combinatorial candidate search + live AWSPricingProvider, ARC Region switch plan compiler (P11-07), and P0-15b schema-migration upgrade registry',
    ],
  },
  {
    id: 'v0.3 (M4 Agents)',
    badge: 'OPT-IN LLM AGENTS',
    badgeClass: 'mark--read',
    title: 'v0.3 — LangGraph Advisor, Candidate Planner & Sandboxed In-Place IaC Edits',
    delivers:
      'Opt-in LangGraph workflows for advisory review and candidate DR planning, plus in-place edits to your existing Terraform modules, plain Kubernetes manifests, Kustomize overlays, and Helm values inside an OS/container-isolated worktree runner.',
    highlights: [
      'Replaceable LLM provider abstraction via init_chat_model (Anthropic, Bedrock, OpenRouter, Ollama)',
      'Local hybrid RAG knowledge base (knowledge/domain/ + versioned SKILL.md + sanitized web_fetch)',
      'Strict redaction of Terraform state, secrets, and env values + full SQLite llm_calls audit log',
      'Mandatory citation verification: uncited LLM proposals are automatically dropped (§2 Rule 11)',
    ],
  },
  {
    id: 'v0.4 (M5 Proven)',
    badge: 'OPERATIONAL PROOF',
    badgeClass: 'mark--read',
    title: 'v0.4 — Proven Readiness from Game Days, ARC Execution Reports & Drift',
    delivers:
      'Ingestion of game-day drill evidence (DRDrill, §53) and Route 53 ARC execution reports to compare predicted vs. proven RTO/RPO, plus continuous architectural drift detection across rescans (§77).',
    highlights: [
      'Tracks predicted vs. proven recovery durations from real game-day exercises',
      'Detects configuration, quota, and dependency drift that invalidates previously READY stacks',
    ],
  },
  {
    id: 'v1.0 (M6 Production)',
    badge: 'GA TARGET',
    badgeClass: 'mark--read',
    title: 'v1.0 — Packaged, Upgradeable, Audited Release',
    delivers:
      'Single-command uv tool installation, schema migration guarantees, comprehensive real-AWS contract test verification, and published AWS service readiness matrix.',
    highlights: [
      'Full verification pyramid: unit fixtures, botocore Stubber / moto, aws/aws-emulator integration, and opt-in real-AWS contract suite',
      'Audited sandbox isolation, versioned duration/pricing catalogs, and production documentation',
    ],
  },
];
---

<BaseLayout
  title="Roadmap & Milestones (M0 PoC to v1.0) — Perpetual"
  description="Engine-first, CLI-first development roadmap for Perpetual: M0 PoC, M1 Alpha (CLI ECS+RDS), v0.1 MVP, v0.2 Expansion (EKS, P2c, Flow Logs, ARC compiler), v0.3 Agents, v0.4 Proven, and v1.0 release."
>
  <main id="main-content" class="page-container">
    <div class="wrap">
      <header class="page-header">
        <div class="breadcrumbs">
          <a href="/">perpetual</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-cur">roadmap</span>
        </div>

        <div class="headline-row">
          <div>
            <p class="kicker"><span>//</span> engine-first · ecs before eks · deterministic before llm</p>
            <h1 class="page-title">Milestone Roadmap</h1>
          </div>
        </div>

        <p class="page-sub">
          Perpetual is pre-alpha: the 7-part engineering specification (<code>§1–§109</code>) and implementation plan are locked, and Milestone M0 PoC is underway.
        </p>
      </header>

      <div class="sections-stream">
        {milestones.map((m) => (
          <section class="card" style="padding:24px 28px;">
            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;border-bottom:1px solid var(--bdr);padding-bottom:14px;margin-bottom:16px;">
              <div style="display:flex;align-items:center;gap:12px;">
                <span style="font-size:18px;font-weight:800;color:var(--amber);">{m.id}</span>
                <span class={`mark ${m.badgeClass}`}>{m.badge}</span>
              </div>
              <span class="lbl">IMPL_PLAN.md &amp; TRACKER.md</span>
            </div>

            <h2 style="font-size:18px;color:var(--txt);margin-bottom:10px;">{m.title}</h2>
            <p style="font-size:13.5px;color:var(--txt-2);line-height:1.7;margin-bottom:16px;">{m.delivers}</p>

            <div style="background:var(--surface);border:1px solid var(--bdr);padding:14px 18px;">
              <div class="lbl" style="margin-bottom:8px;">Key Engineering Deliverables</div>
              <ul style="margin-left:18px;font-size:12.5px;color:var(--txt-2);display:flex;flex-direction:column;gap:6px;">
                {m.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
